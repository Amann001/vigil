# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored: never commit real keys.

# LLM providers (free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=

# PostgreSQL + pgvector (e.g. a Neon free-tier connection string)
DATABASE_URL=

# Agent tracing (Langfuse Cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
