// The live demo on GitHub Codespaces: free for personal accounts (about 60 hours a month of
// this machine), no card. Opening a codespace installs everything; `scripts/live.sh` starts
// the shop and Vigil and prints the public link. See "Run it live" in the README.
{
  "name": "Vigil live demo",
  // GitHub's standard Codespaces image: Python, Node, the GitHub CLI and an SSH server are
  // already in it, and it is cached on Codespaces hosts. (Adding them as features to the slim
  // Python image failed: its Yarn package source has an expired signing key, so apt failed.)
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  // Vigil runs eight processes (four shop services, customers, Prometheus, the API, the
  // watcher, a worker): 2 cores and 8 GB is the smallest machine that holds them comfortably.
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8030],
  "portsAttributes": {
    "8030": { "label": "Vigil war room", "onAutoForward": "notify" }
  },
  // Set once, at github.com/settings/codespaces, with access to this repository.
  "secrets": {
    "GEMINI_API_KEY": { "description": "Google AI Studio key (free tier)" },
    "GROQ_API_KEY": { "description": "Groq key (free tier)" },
    "DATABASE_URL": { "description": "The cloud's own Neon database (the line in .env.cloud)" },
    "VIGIL_API_TOKEN": { "description": "Your password for breaking the shop and approving fixes" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
